{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pier",
  "version": "0.1.0",
  "identifier": "com.timqi.pier-client",
  "build": {
    "frontendDist": "../rail/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
