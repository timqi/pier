{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tabs",
  "description": "The bundled tab bar manages the instances and, as the title bar, moves and sizes the window.",
  "webviews": ["tabs"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "allow-list",
    "allow-add",
    "allow-close",
    "allow-rename",
    "allow-reorder",
    "allow-select",
    "allow-popup"
  ]
}
