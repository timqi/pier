{
  "name": "pier",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && tsx watch src/main.ts",
    "dev:web": "vite",
    "build": "tsc && npm run build:web",
    "build:web": "vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@hono/node-server": "^2.1.1",
    "croner": "^10.0.1",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.3",
    "marked": "^18.0.10",
    "typebox": "^1.3.7"
  }
}
